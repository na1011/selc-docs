{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Edit(~/selc-docs/CLAUDE.md)",
      "Edit(~/selc-docs/.gitignore)",
      "Edit(~/selc-docs/.claude/settings.json)",
      "Edit(~/selc-docs/.claude/skills/**)",
      "Edit(~/selc-docs/임시문서팩/**)",
      "Edit(~/selc-docs/정리본/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git branch --show-current)\" = main ] && exit 0; n=$(git rev-list --count HEAD..origin/main 2>/dev/null); if [ \"${n:-0}\" -gt 0 ]; then echo \"이 브랜치는 origin/main보다 ${n}커밋 뒤처져 있다. 작업을 시작하기 전에 사용자에게 git rebase origin/main을 제안한다.\"; fi"
          }
        ]
      }
    ]
  }
}
